<odoo>
    <record model="ir.ui.view" id="social_account_view_form_inherit">
        <field name="name">social.account.view.form.inherit.instagram</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="social_media_base.social_account_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='update_account']" position="after">
                <button
                    string="Refresh statistics"
                    class="oe_stat_button"
                    type="object"
                    name="action_instagram_refresh"
                    invisible="media_type != 'instagram' or instagram_token_expired"
                    title="Read the latest publications and their statistics from Instagram now."
                />
                <button
                    string="Check connection"
                    class="oe_stat_button"
                    type="object"
                    name="action_instagram_check_connection"
                    invisible="media_type != 'instagram'"
                    title="Ask Instagram for the profile of the account, refreshing the token when it is about to expire."
                />
            </xpath>
            <xpath expr="//field[@name='image_1920']" position="before">
                <div
                    class="alert alert-danger"
                    role="alert"
                    invisible="media_type != 'instagram' or not instagram_token_expired"
                >
                    The Instagram authorization of this account expired. Use
                    <b>Update account</b> to authorize it again.
                </div>
                <div
                    class="oe_button_box"
                    name="instagram_button_box"
                    invisible="media_type != 'instagram'"
                >
                    <button
                        class="oe_stat_button"
                        type="object"
                        name="action_instagram_open_pending"
                        icon="fa-hand-pointer-o"
                    >
                        <field
                            name="instagram_pending_count"
                            widget="statinfo"
                            string="To publish"
                        />
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='account_url']" position="after">
                <field
                    name="instagram_account_type"
                    invisible="media_type != 'instagram'"
                />
                <field
                    name="instagram_followers_count"
                    invisible="media_type != 'instagram'"
                />
                <field
                    name="instagram_follows_count"
                    invisible="media_type != 'instagram'"
                />
                <field
                    name="instagram_media_count"
                    invisible="media_type != 'instagram'"
                />
            </xpath>
            <xpath expr="//page[@name='account_configuration']" position="inside">
                <group invisible="media_type != 'instagram'">
                    <group string="Meta App">
                        <field name="instagram_app_id" readonly="1" />
                        <field name="instagram_app_secret" password="1" readonly="1" />
                        <field name="instagram_granted_scopes" />
                    </group>
                    <group string="Token">
                        <field name="instagram_token_date" />
                        <field name="expire_access_token_date" readonly="1" />
                        <field name="instagram_token_expired" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
