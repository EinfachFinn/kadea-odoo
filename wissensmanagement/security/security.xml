<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wissensmanagement" model="ir.module.category">
        <field name="name">Wissensmanagement</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_wissensmanagement" model="res.groups.privilege">
        <field name="name">Wissensmanagement</field>
        <field name="category_id" ref="module_category_wissensmanagement"/>
    </record>

    <record id="group_reader" model="res.groups">
        <field name="name">Leser</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_wissensmanagement"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Darf alle Wissensseiten lesen.</field>
    </record>

    <record id="group_editor" model="res.groups">
        <field name="name">Bearbeiter</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_wissensmanagement"/>
        <field name="implied_ids" eval="[Command.link(ref('group_reader'))]"/>
        <field name="comment">Darf Seiten erstellen, bearbeiten, verschieben, duplizieren und löschen.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_wissensmanagement"/>
        <field name="implied_ids" eval="[Command.link(ref('group_editor'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Darf zusätzlich Wissensordner, Stil und Ordnerrechte konfigurieren.</field>
    </record>
</odoo>
