    <menuitem id="menu_wm_config" name="Konfiguration" parent="menu_wm_root" sequence="90" groups="wissensmanagement.group_manager"/>
    <menuitem id="menu_wm_access" name="Ordnerrechte" parent="menu_wm_config" sequence="20"
              action="action_wissen_access_rule" groups="wissensmanagement.group_manager"/>
    <menuitem id="menu_wm_settings" name="Einstellungen" parent="menu_wm_config" sequence="10"
