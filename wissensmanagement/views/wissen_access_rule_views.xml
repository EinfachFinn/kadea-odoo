<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wissen_access_rule_view_list" model="ir.ui.view">
        <field name="name">wissen.access.rule.list</field>
        <field name="model">wissen.access.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="folder" placeholder="z. B. Vertrieb"/>
                <field name="read_group_ids" widget="many2many_tags"/>
                <field name="write_group_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_wissen_access_rule" model="ir.actions.act_window">
        <field name="name">Ordnerrechte</field>
        <field name="res_model">wissen.access.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Rechte pro Ordner festlegen</p>
            <p>Beispiel: Ordner <b>Vertrieb</b>, Lesen = Gruppe „Vertrieb / Benutzer“. Dann sehen nur diese Personen
               (und Wissensmanagement-Administratoren) den Ordner samt Unterseiten. Ohne Regel sehen alle Leser alles.</p>
        </field>
    </record>
</odoo>
